# ─────────────────────────────────────────────────────────────────────────────
# PosterPal — environment template (copy to `.env`, fill in real values).
# Every key below is actually read by the code. Optional keys are marked.
# NEVER commit `.env` — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. The worker and migrations require it; the web app
# falls back to embedded PGLite (in-memory/persisted) when unset.
DATABASE_URL=postgres://posterpal:CHANGE_ME@127.0.0.1:5432/posterpal

# ── Auth ─────────────────────────────────────────────────────────────────────
# "false" = single-operator desk (no login, localhost default).
# anything else (e.g. "true") = require email/password login (self-host).
VITE_AUTH_ENABLED=true

# Signing secret for Better Auth sessions (32+ random bytes). Required in prod.
BETTER_AUTH_SECRET=CHANGE_ME_32_bytes_min

# Public base URL of the app (used for OAuth redirect / cookie host).
# Optional — defaults to the request origin.
# BETTER_AUTH_URL=https://posterpal.example.com

# First-run operator (optional). When set and no user exists yet, PosterPal
# seeds this account on boot so you have a known login.
POSTERPAL_ADMIN_EMAIL=operator@example.com
POSTERPAL_ADMIN_PASSWORD=CHANGE_ME

# ── Encryption ───────────────────────────────────────────────────────────────
# Master key for the AES-GCM Facebook-token vault (32+ bytes). Falls back to
# BETTER_AUTH_SECRET. Required in production — the app refuses the preview key.
POSTERPAL_MASTER_KEY=CHANGE_ME_32_bytes_min

# ── AI (optional) ────────────────────────────────────────────────────────────
# xAI / Grok key for captions, replies and the research agent.
# XAI_API_KEY=xai-CHANGE_ME

# ── Grok auth broker (optional — federated Google/X sign-in instead of email) ─
# Only set these if you federate identity through the Grok broker. Leave unset
# to use local email/password alone.
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=CHANGE_ME
# GROK_AUTH_CLIENT_SECRET=CHANGE_ME

# ── Public host (optional) ───────────────────────────────────────────────────
# Public hostname used to build OG image / meta URLs.
# VITE_PUBLIC_HOSTNAME=posterpal.example.com

# ── Worker ───────────────────────────────────────────────────────────────────
# Background scheduler tick interval in ms (default 60000).
# POSTERPAL_WORKER_INTERVAL_MS=60000
# Operator id the worker acts as (defaults to the first app_settings row / dev-user).
# POSTERPAL_USER_ID=dev-user

# ── Embedded database (optional) ─────────────────────────────────────────────
# PGLITE_MEMORY=1      # force in-memory (throwaway)
# PGLITE_DATA_DIR=/data # persist PGLite to a custom directory
